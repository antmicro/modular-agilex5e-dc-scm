(version 1)

#---------------------- 85 Ohm diff ----------------------
(rule "85_Ohm_inner"
	(layer inner)
	(condition "(A.NetClass == '85Ohm-diff')")
	(constraint track_width (opt 0.152mm))
	(constraint diff_pair_gap  (opt 0.150mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)
(rule "85_Ohm_outer"
	(layer outer)
	(condition "(A.NetClass == '85Ohm-diff')")
	(constraint track_width (opt 0.178mm))
	(constraint diff_pair_gap  (opt 0.136mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)

#---------------------- 90 Ohm diff ----------------------
(rule "90_Ohm_inner"
	(layer inner)
	(condition "(A.NetClass == '90Ohm-diff')")
	(constraint track_width (opt 0.16mm))
	(constraint diff_pair_gap  (opt 0.136mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)
(rule "90_Ohm_outer"
	(layer outer)
	(condition "(A.NetClass == '90Ohm-diff')")
	(constraint track_width (opt 0.16mm))
	(constraint diff_pair_gap  (opt 0.136mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)

#---------------------- 100 Ohm diff ----------------------
(rule "100_Ohm_inner"
	(layer inner)
	(condition "(A.NetClass == '100Ohm-diff')")
	(constraint track_width (opt 0.125mm))
	(constraint diff_pair_gap  (opt 0.235mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)
(rule "100_Ohm_outer"
	(layer outer)
	(condition "(A.NetClass == '100Ohm-diff')")
	(constraint track_width (opt 0.16mm))
	(constraint diff_pair_gap  (opt 0.240mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)

#---------------------- 50 Ohm se ----------------------
(rule "50_Ohm_inner"
	(layer inner)
	(condition "(A.NetClass == '50Ohm-se')")
	(constraint track_width (opt 0.195mm))
)
(rule "50_Ohm_outer"
	(layer outer)
	(condition "(A.NetClass == '50Ohm-se')")
	(constraint track_width (opt 0.21mm))
)

(rule "ULPI1_skew"
	(condition "(A.NetName  == '*ULPI1*')")
	(constraint length ( min 320ps)( opt 370ps) ( max 420ps))
)

(rule "ULPI0_skew"
	(condition "(A.NetName  == '*ULPI0*')")
	(constraint length ( min 150ps)( opt 200ps) ( max 250ps))
)

(rule "DC_SCM_ESPI_skew"
	(condition "(A.NetName  == '*DC_SCM_ESPI*')")
	(constraint length ( min 500ps)( opt 525ps) ( max 550ps))
)

(rule "QSPI_HPMCNTRL._skew"
	(condition "(A.NetName  == '*QSPI_HPMCNTRL.*')")
	(constraint length ( min 290ps)( opt 300ps) ( max 310ps))
)

(rule "QSPI_HPMCNTRL__skew"
	(condition "(A.NetName  == '*QSPI_HPMCNTRL_*')")
	(constraint length ( min 35ps)( opt 45ps) ( max 55ps))
)

(rule "uSD_skew"
	(condition "(A.NetName  == '*uSD*')")
	(constraint length ( min 440ps)( opt 450ps) ( max 460ps))
)

(rule "GbE.TX_skew"
	(condition "(A.NetName  == '*GbE.TX*')")
	(constraint length ( min 315ps)( opt 340ps) ( max 365ps))
)

(rule "GbE.RX_skew"
	(condition "(A.NetName  == '*GbE.RX*')")
	(constraint length ( min 400ps)( opt 425ps) ( max 450ps))
)

(rule "BIOS._skew"
	(condition "(A.NetName  == '*BIOS.*') && (A.NetName  != '*CS*')")
	(constraint length ( min 190ps)( opt 200ps) ( max 210ps))
)

(rule "Net-(J1G-HVIO_6C_skew"
	(condition "(A.NetName  == '*Net-(J1G-HVIO_6C*')")
	(constraint length ( min 510ps)( opt 520ps) ( max 530ps))
)

(rule "Net-(J1201_skew"
	(condition "(A.NetName  == '*Net-(J1201*') && (A.NetClass == '90Ohm-diff')")
	(constraint length ( min 77ps)( opt 87ps) ( max 97ps))
)

(rule "Net-(J1202_skew"
	(condition "(A.NetName  == '*Net-(J1202*') && (A.NetClass == '90Ohm-diff')")
	(constraint length ( min 77ps)( opt 87ps) ( max 97ps))
)
